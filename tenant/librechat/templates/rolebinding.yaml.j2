---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: edit-{{ .Values.user }}
  namespace: {{ .Values.namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: edit
subjects:
- apiGroup: rbac.authorization.k8s.io
  kind: User
  name: {{ .Values.user }}
---
# Allows the default SA (used by the readiness-check PostSync job) to read routes
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: readiness-check
  namespace: {{ .Values.namespace }}
rules:
- apiGroups: ["route.openshift.io"]
  resources: ["routes"]
  verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: readiness-check
  namespace: {{ .Values.namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: readiness-check
subjects:
- kind: ServiceAccount
  name: default
  namespace: {{ .Values.namespace }}
